---
import { languages, type Lang } from "../i18n";

interface Props {
  current: Lang;
}

const { current } = Astro.props;

const items: { code: Lang; href: string; label: string }[] = [
  { code: "en", href: "/", label: "EN" },
  { code: "ru", href: "/ru/", label: "RU" },
  { code: "uk", href: "/uk/", label: "UK" },
];

const longLabel: Record<Lang, string> = {
  en: languages.en,
  ru: languages.ru,
  uk: languages.uk,
};
---

<nav class="flex gap-1.5 font-mono text-[11px]" aria-label="Language">
  {
    items.map(({ code, href, label }) => (
      <a
        href={href}
        class:list={[
          "border-line border px-2.5 py-1.25 tracking-[0.1em] transition-colors duration-200",
          code === current
            ? "border-signal-dk text-ice"
            : "text-steel-dim hover:border-signal-dk hover:text-ice",
        ]}
        hreflang={code}
        lang={code}
        aria-current={code === current ? "true" : undefined}
        data-lang={code}
        title={longLabel[code]}
      >
        {label}
      </a>
    ))
  }
</nav>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>("nav[aria-label='Language'] a[data-lang]")
    .forEach((a) => {
      a.addEventListener("click", () => {
        try {
          localStorage.setItem("lang", a.dataset.lang!);
        } catch {
          /* ignore */
        }
      });
    });
</script>
