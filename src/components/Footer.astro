---
import type { Dictionary, Lang } from "../i18n";
import { getLangFromUrl } from "../i18n";
import { siteConfig } from "../config";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  footer: Dictionary["footer"];
}

const { footer } = Astro.props;
const currentLang: Lang = getLangFromUrl(Astro.url);
---

<footer
  class="mono bg-paper-deep text-muted flex items-center justify-between px-6 py-6 text-[11px] sm:px-11"
>
  <div class="flex items-center gap-4">
    <ThemeToggle />
    <LangSwitch current={currentLang} />
  </div>
  <div class="flex items-center gap-5">
    <a href={siteConfig.githubUrl} class="subtle" rel="me noopener noreferrer" target="_blank">
      {footer.githubLabel}<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a href={siteConfig.linkedinUrl} class="subtle" rel="me noopener noreferrer" target="_blank">
      {footer.linkedinLabel}<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</footer>
