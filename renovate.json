{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Sofia",
  "schedule": ["before 6am on monday"],
  "rangeStrategy": "bump",
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Auto-merge patch + minor once CI is green",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Group devDependency minor/patch into one PR",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "devDependencies"
    },
    {
      "description": "Hold majors for review + label for the agent",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["dep:major-review"]
    }
  ]
}
