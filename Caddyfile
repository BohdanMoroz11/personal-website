:80 {
	root * /srv
	encode gzip zstd

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@html path *.html /
	header @html Cache-Control "no-cache"

	# Force the CV to download rather than preview inline. The <a download>
	# attribute is only advisory for PDFs; this header is authoritative.
	@cvpdf path /cv.pdf
	header @cvpdf Content-Disposition "attachment; filename=\"Bohdan-Moroz-CV.pdf\""

	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
