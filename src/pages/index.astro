---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import FactsTable from "../components/FactsTable.astro";
import Work from "../components/Work.astro";
import HowIWork from "../components/HowIWork.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Base lang={lang} meta={t.meta}>
  <Hero hero={t.hero} />
  <FactsTable facts={t.facts} email={t.footer.email} />
  <Work work={t.work} />
  <HowIWork howIWork={t.howIWork} />
  <Contact contact={t.contact} email={t.footer.email} />
  <Footer location={t.hero.location} footer={t.footer} />
</Base>
