---
import Base from "../layouts/Base.astro";
import NotFound from "../components/NotFound.astro";
import Footer from "../components/Footer.astro";
import {
  defaultLang,
  getLangFromUrl,
  languages,
  useTranslations,
  type Dictionary,
  type Lang,
} from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const hrefs: Record<Lang, string> = { en: "/", ru: "/ru/", uk: "/uk/" };
const homeHref = hrefs[lang];

type Payload = Record<
  Lang,
  {
    notFound: Dictionary["notFound"];
    title: string;
    description: string;
    homeHref: string;
  }
>;

const i18nPayload = (Object.keys(languages) as Lang[]).reduce((acc, l) => {
  const d = useTranslations(l);
  acc[l] = {
    notFound: d.notFound,
    title: d.meta.title,
    description: d.meta.description,
    homeHref: hrefs[l],
  };
  return acc;
}, {} as Payload);
---

<Base lang={lang} meta={t.meta} schema={t.schema}>
  <NotFound notFound={t.notFound} homeHref={homeHref} />
  <Footer footer={t.footer} />

  <script is:inline define:vars={{ payload: i18nPayload, serverLang: lang, defaultLang }}>
    (() => {
      try {
        const supported = Object.keys(payload);

        const pick = () => {
          const stored = localStorage.getItem("lang");
          if (stored && supported.includes(stored)) return stored;
          const navs =
            navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || "en"];
          for (const raw of navs) {
            const base = (raw || "").toLowerCase().split("-")[0];
            if (supported.includes(base)) return base;
          }
          return defaultLang;
        };

        const lang = pick();
        if (lang === serverLang) return;

        const data = payload[lang];
        if (!data) return;

        document.documentElement.lang = lang;
        document.title = data.title;

        const desc = document.querySelector('meta[name="description"]');
        if (desc) desc.setAttribute("content", data.description);

        const bl = document.getElementById("nf-bootline");
        if (bl) {
          bl.dataset.prefix = data.notFound.bootline.prefix;
          bl.dataset.status = data.notFound.bootline.status;
        }

        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          const value = data.notFound[key];
          if (typeof value === "string") el.textContent = value;
        });

        const back = document.querySelector("[data-back-link]");
        if (back) back.setAttribute("href", data.homeHref);
      } catch {
        /* ignore */
      }
    })();
  </script>
</Base>
