---
import Base from "../layouts/Base.astro";
import { getLangFromUrl, useTranslations } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Base lang={lang} meta={t.meta}>
  <section class="px-6 pt-12 pb-12 sm:px-11 sm:pt-16 sm:pb-16">
    <div class="label">§ 404 — Not found</div>
    <h1 class="serif mt-3 text-4xl leading-[1.05] sm:text-[40px]">This page doesn't exist.</h1>
    <p class="mt-4 text-[15px] leading-[1.6] text-[var(--color-ink-soft)]">
      The URL you followed isn't here. The site is a single page — try the front door.
    </p>
    <a href="/" class="serif mt-6 inline-block text-[18px] text-[var(--color-ink)]">
      <span class="highlight-underline">Back to bohdanmoroz.com</span>
      <span
        class="ml-0.5 inline-block align-[2px] font-sans text-[12px] leading-none text-[var(--color-muted)]"
        >→</span
      >
    </a>
  </section>
</Base>
