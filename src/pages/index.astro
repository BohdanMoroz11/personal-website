---
import "../styles/global.css";
import { getLangFromUrl, useTranslations } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t.meta.description} />
    <title>{t.meta.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://bohdanmoroz.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://bohdanmoroz.com/" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content="https://bohdanmoroz.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://bohdanmoroz.com/og-image.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
    />
  </head>

  <body class="min-h-screen bg-[var(--color-paper)] text-[var(--color-ink)]">
    <main class="mx-auto max-w-[760px] px-5 py-10 sm:py-16">
      <article
        class="overflow-hidden rounded-2xl border border-[var(--color-paper-edge)] bg-[var(--color-paper)]"
      >
        <!-- Hero -->
        <header class="px-6 pt-10 pb-7 sm:px-11 sm:pt-12">
          <div class="label">{t.hero.location}</div>
          <h1 class="serif mt-3 text-4xl leading-[1.05] sm:text-[40px]">
            {t.hero.name}
          </h1>
          <p
            class="serif mt-2 text-[22px] leading-[1.2] text-[var(--color-ink-soft)] sm:text-[24px]"
          >
            {t.hero.roleGeneral} · <span class="highlight-underline">{t.hero.roleEmphasis}</span>.
          </p>
        </header>

        <div class="px-6 pb-2 sm:px-11">
          <div class="row">
            <div class="label">{t.facts.focusLabel}</div>
            <div class="text-[15px] text-[var(--color-ink-soft)]">
              {t.facts.focusValue}
            </div>
            <div class="row-right mono text-[11px] text-[var(--color-muted)]">
              {t.facts.focusAside}
            </div>
          </div>
          <div class="row">
            <div class="label">{t.facts.domainsLabel}</div>
            <div class="text-[15px] text-[var(--color-ink-soft)]">
              {t.facts.domainsValue}
            </div>
            <div class="row-right mono text-[11px] text-[var(--color-muted)]">
              {t.facts.domainsAside}
            </div>
          </div>
          <div class="row">
            <div class="label">{t.facts.stackLabel}</div>
            <div class="text-[15px] text-[var(--color-ink-soft)]">
              {t.facts.stackValue}
            </div>
            <div class="row-right mono text-[11px] text-[var(--color-muted)]">
              {t.facts.stackAside}
            </div>
          </div>
          <div class="row">
            <div class="label">{t.facts.infraLabel}</div>
            <div class="text-[15px] text-[var(--color-ink-soft)]">
              {t.facts.infraValue}
            </div>
            <div class="row-right"></div>
          </div>
          <div class="row">
            <div class="label">{t.facts.workingLabel}</div>
            <div class="text-[15px] text-[var(--color-ink-soft)]">
              {t.facts.workingValue}
            </div>
            <div class="row-right"></div>
          </div>
          <div class="row" style="border-bottom: none;">
            <div class="label">{t.facts.statusLabel}</div>
            <div class="flex items-center text-[15px] text-[var(--color-ink-soft)]">
              <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-live)]"
              ></span>
              {t.facts.statusValue}
            </div>
            <div class="row-right mono text-[11px] text-[var(--color-muted)]">
              <a href={`mailto:${t.footer.email}`} class="subtle">{t.facts.statusAside}</a>
            </div>
          </div>
        </div>

        <!-- Selected work -->
        <section id="work" class="section-divider px-6 pt-9 pb-2 sm:px-11">
          <div class="label">{t.work.section}</div>
          <h2 class="serif mt-2 text-[22px]">
            {t.work.heading}
          </h2>
        </section>

        <div class="px-6 pb-2 sm:px-11">
          {
            t.work.projects.map((p, i) => (
              <div
                class={`grid grid-cols-[90px_1fr] gap-4 py-6 ${
                  i < t.work.projects.length - 1 ? "border-b border-[var(--color-paper-line)]" : ""
                }`}
              >
                <div class="mono pt-1 text-[10px] tracking-[0.15em] text-[var(--color-muted)]">
                  {p.num}
                </div>
                <div>
                  <div>
                    {p.url ? (
                      <a
                        href={p.url}
                        target="_blank"
                        rel="noopener"
                        class="serif text-[19px] text-[var(--color-ink)] transition-colors hover:text-[var(--color-ink-soft)]"
                      >
                        {p.title}
                        <span class="ml-0.5 inline-block align-[2px] font-sans text-[11px] leading-none text-[var(--color-muted)]">
                          ↗
                        </span>
                        {p.linkLabel && (
                          <span class="mono inline-flex items-center gap-1 align-[1px] text-[10.5px] leading-none text-[var(--color-muted)]">
                            {p.linkLabel}
                          </span>
                        )}
                      </a>
                    ) : (
                      <span class="serif text-[19px]">{p.title}</span>
                    )}
                    <span class="label ml-2">{p.tag}</span>
                  </div>
                  <p class="mt-1.5 text-[13.5px] leading-[1.55] text-[var(--color-ink-body)]">
                    {p.desc}
                  </p>
                  {p.metric && (
                    <div class="mono mt-2 text-[11px] text-[var(--color-ink-soft)]">{p.metric}</div>
                  )}
                  <div class="mono mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[10.5px] text-[var(--color-muted)]">
                    {p.meta.map((m, j) => (
                      <span>
                        {j > 0 && <span class="mr-2 text-[var(--color-muted-line)]">·</span>}
                        {m}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <!-- How I work -->
        <section class="section-divider px-6 pt-9 pb-2 sm:px-11">
          <div class="label">{t.howIWork.section}</div>
          <h2 class="serif mt-2 text-[22px]">
            {t.howIWork.heading}
          </h2>
        </section>

        <div class="px-6 pb-7 sm:px-11">
          {
            t.howIWork.items.map((h, i) => (
              <div
                class={`grid grid-cols-[24px_1fr] gap-3.5 py-3 ${
                  i < t.howIWork.items.length - 1 ? "dot-divider" : ""
                }`}
              >
                <div class="mono pt-0.5 text-[11px] text-[var(--color-muted)]">{h.n}</div>
                <p class="text-[14px] leading-[1.55] text-[var(--color-ink-soft)]">{h.text}</p>
              </div>
            ))
          }
        </div>

        <!-- Get in touch -->
        <section class="section-divider px-6 pt-9 pb-2 sm:px-11">
          <div class="label">{t.contact.section}</div>
          <h2 class="serif mt-2 text-[22px]">
            {t.contact.heading}
          </h2>
        </section>

        <div class="px-6 pb-9 sm:px-11">
          <p class="mt-1 text-[14px] leading-[1.6] text-[var(--color-ink-soft)]">
            {t.contact.body}
          </p>
          <a
            href={`mailto:${t.footer.email}`}
            class="serif mt-5 inline-block text-[20px] text-[var(--color-ink)]"
          >
            <span class="highlight-underline">{t.footer.email}</span>
            <span
              class="ml-0.5 inline-block align-[2px] font-sans text-[12px] leading-none text-[var(--color-muted)]"
              >↗</span
            >
          </a>
        </div>

        <!-- Footer -->
        <footer
          class="mono flex items-center justify-between bg-[var(--color-paper-deep)] px-6 py-6 text-[11px] text-[var(--color-muted)] sm:px-11"
        >
          <span>{t.hero.location}</span>
          <div class="flex gap-5">
            <a href={t.footer.githubUrl} class="subtle" rel="me" target="_blank"
              >{t.footer.githubLabel}</a
            >
            <a href={t.footer.linkedinUrl} class="subtle" rel="me" target="_blank"
              >{t.footer.linkedinLabel}</a
            >
          </div>
        </footer>
      </article>
    </main>
  </body>
</html>
