---

---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-label="Toggle theme"
  title="Theme"
>
  <svg
    data-icon="system"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <circle cx="8" cy="8" r="5"></circle>
    <path d="M8 3 V13"></path>
    <path d="M8 3 A5 5 0 0 1 8 13 Z" fill="currentColor" stroke="none"></path>
  </svg>
  <svg
    data-icon="light"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="8" cy="8" r="2.8"></circle>
    <path
      d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1"
    ></path>
  </svg>
  <svg data-icon="dark" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path
      d="M11.5 10.5A5.5 5.5 0 0 1 5.5 4.5c0-.6.1-1.2.3-1.7A6 6 0 1 0 13.2 10.2c-.5.2-1.1.3-1.7.3z"
    ></path>
  </svg>
</button>

<script>
  type ThemePref = "system" | "light" | "dark";

  const root = document.documentElement;
  const mql = window.matchMedia("(prefers-color-scheme: dark)");
  const btn = document.getElementById("theme-toggle");
  const order: ThemePref[] = ["system", "light", "dark"];
  const labels: Record<ThemePref, string> = {
    system: "Theme: auto",
    light: "Theme: light",
    dark: "Theme: dark",
  };

  const resolve = (pref: ThemePref) =>
    pref === "system" ? (mql.matches ? "dark" : "light") : pref;

  const apply = (pref: ThemePref) => {
    root.dataset.themePref = pref;
    root.dataset.theme = resolve(pref);
    btn?.setAttribute("aria-label", labels[pref]);
    btn?.setAttribute("title", labels[pref]);
  };

  const currentPref = (): ThemePref => (root.dataset.themePref as ThemePref) || "system";

  apply(currentPref());

  btn?.addEventListener("click", () => {
    const next = order[(order.indexOf(currentPref()) + 1) % order.length];
    try {
      if (next === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", next);
    } catch {
      /* ignore */
    }
    apply(next);
  });

  mql.addEventListener("change", () => {
    if (currentPref() === "system") apply("system");
  });
</script>
