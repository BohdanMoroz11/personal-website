---
import type { Dictionary, Lang } from "../i18n";
import { getLangFromUrl } from "../i18n";
import { siteConfig } from "../config";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  footer: Dictionary["footer"];
}

const { footer } = Astro.props;
const currentLang: Lang = getLangFromUrl(Astro.url);
---

<footer class="py-[34px] max-sm:py-[26px]">
  <div class="site-wrap flex flex-wrap items-center justify-between gap-[18px] max-sm:gap-3.5">
    <LangSwitch current={currentLang} />

    <div class="flex gap-2">
      <a
        href={siteConfig.githubUrl}
        class="border-line text-steel-dim hover:border-line-2 hover:text-ice border px-3.25 py-1.75 font-mono text-[11px] tracking-[0.1em] uppercase transition-colors duration-200"
        rel="me noopener noreferrer"
        target="_blank"
      >
        {footer.githubLabel}<span class="sr-only"> (opens in a new tab)</span>
      </a>
      <a
        href={siteConfig.linkedinUrl}
        class="border-line text-steel-dim hover:border-line-2 hover:text-ice border px-3.25 py-1.75 font-mono text-[11px] tracking-[0.1em] uppercase transition-colors duration-200"
        rel="me noopener noreferrer"
        target="_blank"
      >
        {footer.linkedinLabel}<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>

    <p class="text-steel font-mono text-[10px] tracking-[0.08em]">
      {footer.signature}
      <span class="text-signal">{footer.signatureAccent}</span>
    </p>
  </div>
</footer>

