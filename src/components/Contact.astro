---
import type { Dictionary } from "../i18n";

interface Props {
  contact: Dictionary["contact"];
  email: string;
}

const { contact, email } = Astro.props;
---

<section class="section-divider px-6 pt-9 pb-2 sm:px-11">
  <div class="label">{contact.section}</div>
  <h2 class="serif mt-2 text-[22px]">{contact.heading}</h2>
</section>

<div class="px-6 pb-9 sm:px-11">
  <p class="text-ink-soft mt-1 text-[14px] leading-[1.6]">
    {contact.body}
  </p>
  <a href={`mailto:${email}`} class="serif text-ink mt-5 inline-block text-[20px]">
    <span class="highlight-underline">{email}</span>
    <span
      aria-hidden="true"
      class="text-muted ml-0.5 inline-block align-[2px] font-sans text-[12px] leading-none">↗</span
    >
  </a>
</div>
