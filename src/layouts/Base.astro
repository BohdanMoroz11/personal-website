---
import "@fontsource/chakra-petch/400.css";
import "@fontsource/chakra-petch/500.css";
import "@fontsource/chakra-petch/600.css";
import "@fontsource/chakra-petch/700.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "../styles/global.css";
import type { Dictionary, Lang } from "../i18n";
import { mailtoContact, siteConfig } from "../config";

interface Props {
  lang: Lang;
  meta: Dictionary["meta"];
  schema: Dictionary["schema"];
}

const { lang, meta, schema } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL("/og-image.png", Astro.site).href;
const siteUrl = Astro.site?.href ?? "https://bohdanmoroz.com/";

const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;
const profilePageId = `${canonicalUrl}#profile`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: siteConfig.person.name,
      givenName: siteConfig.person.givenName,
      familyName: siteConfig.person.familyName,
      alternateName: [...siteConfig.person.alternateNames],
      jobTitle: schema.jobTitle,
      description: meta.description,
      url: siteUrl,
      mainEntityOfPage: { "@id": profilePageId },
      image: {
        "@type": "ImageObject",
        url: ogImageUrl,
        width: 1200,
        height: 630,
      },
      email: mailtoContact,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Sofia",
        addressCountry: "BG",
      },
      workLocation: {
        "@type": "Place",
        name: schema.workLocationName,
        address: {
          "@type": "PostalAddress",
          addressLocality: "Sofia",
          addressCountry: "BG",
        },
      },
      nationality: { "@type": "Country", name: "Ukraine" },
      knowsLanguage: [
        { "@type": "Language", name: "English", alternateName: "en" },
        { "@type": "Language", name: "Ukrainian", alternateName: "uk" },
        { "@type": "Language", name: "Russian", alternateName: "ru" },
      ],
      knowsAbout: [...siteConfig.knowsAbout],
      worksFor: {
        "@type": "Organization",
        name: siteConfig.employer.name,
        url: siteConfig.employer.url,
      },
      hasOccupation: {
        "@type": "Occupation",
        name: schema.occupationName,
        occupationLocation: {
          "@type": "City",
          name: "Sofia",
        },
        skills: schema.occupationSkills,
      },
      seeks: {
        "@type": "Demand",
        name: schema.seeksName,
        description: schema.seeksDescription,
      },
      sameAs: [siteConfig.githubUrl, siteConfig.linkedinUrl],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl,
      name: siteConfig.person.name,
      description: meta.description,
      inLanguage: lang,
      publisher: { "@id": personId },
      author: { "@id": personId },
    },
    {
      "@type": "ProfilePage",
      "@id": profilePageId,
      url: canonicalUrl,
      name: meta.title,
      description: meta.description,
      inLanguage: lang,
      isPartOf: { "@id": websiteId },
      about: { "@id": personId },
      mainEntity: { "@id": personId },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: ogImageUrl,
        width: 1200,
        height: 630,
      },
    },
  ],
};

const gaInitScript = siteConfig.googleAnalyticsId
  ? [
      "window.dataLayer = window.dataLayer || [];",
      "function gtag(){dataLayer.push(arguments);}",
      "gtag('js', new Date());",
      `gtag('config', '${siteConfig.googleAnalyticsId}');`,
    ].join("\n")
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={meta.description} />
    <meta name="author" content="Bohdan Moroz" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />
    <title>{meta.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    <meta name="theme-color" content="#191e24" />

    <!-- V1 theme bootstrap — restore when light theme returns
    <meta name="theme-color" content="#fbfaf6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1714" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const resolved =
            stored === "light" || stored === "dark" ? stored : systemDark ? "dark" : "light";
          const pref = stored === "light" || stored === "dark" ? stored : resolved;
          document.documentElement.dataset.theme = resolved;
          document.documentElement.dataset.themePref = pref;
        } catch {
          /* ignore */
        }
      })();
    </script>
    -->

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={new URL("/", Astro.site).href} />
    <link rel="alternate" hreflang="ru" href={new URL("/ru/", Astro.site).href} />
    <link rel="alternate" hreflang="uk" href={new URL("/uk/", Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} />

    <script is:inline define:vars={{ currentLang: lang }}>
      (() => {
        try {
          const supported = ["en", "ru", "uk"];
          const paths = { en: "/", ru: "/ru/", uk: "/uk/" };
          const stored = localStorage.getItem("lang");

          const pick = () => {
            if (stored && supported.includes(stored)) return stored;
            const navs =
              navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language || "en"];
            for (const raw of navs) {
              const tag = (raw || "").toLowerCase();
              const base = tag.split("-")[0];
              if (supported.includes(base)) return base;
            }
            return "en";
          };

          const target = pick();
          // Only auto-redirect from the unprefixed default root. If a user
          // explicitly lands on /ru/ or /uk/, respect that — even if their
          // navigator language or stored preference says otherwise.
          if (target !== currentLang && window.location.pathname === "/") {
            window.location.replace(paths[target] + window.location.search + window.location.hash);
          }
        } catch {
          /* ignore */
        }
      })();
    </script>

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Bohdan Moroz" />
    <meta
      property="og:locale"
      content={lang === "en" ? "en_US" : lang === "ru" ? "ru_RU" : lang === "uk" ? "uk_UA" : lang}
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bohdan Moroz — Software Engineer, Applied AI" />
    <meta property="profile:first_name" content="Bohdan" />
    <meta property="profile:last_name" content="Moroz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Bohdan Moroz — Software Engineer, Applied AI" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    {
      siteConfig.googleAnalyticsId && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.googleAnalyticsId}`}
          />
          {gaInitScript && <script is:inline set:html={gaInitScript} />}
        </>
      )
    }
  </head>

  <body>
    <div class="fx-grid" aria-hidden="true"></div>
    <div class="fx-scan" aria-hidden="true"></div>
    <slot />
  </body>
</html>
