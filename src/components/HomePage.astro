---
import Base from "../layouts/Base.astro";
import Topbar from "./Topbar.astro";
import Hero from "./Hero.astro";
import Protocol from "./Protocol.astro";
import Dossier from "./Dossier.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import SiteClient from "./SiteClient.astro";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} meta={t.meta} schema={t.schema}>
  <Topbar topbar={t.topbar} />
  <main>
    <Hero hero={t.hero} />
    <Protocol protocol={t.protocol} />
    <Dossier dossier={t.dossier} />
    <Contact contact={t.contact} />
  </main>
  <Footer footer={t.footer} />
  <SiteClient />
</Base>
