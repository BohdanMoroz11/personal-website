---
import type { Dictionary } from "../i18n";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  footer: Dictionary["footer"];
}

const { footer } = Astro.props;
---

<footer
  class="mono bg-paper-deep text-muted flex items-center justify-between px-6 py-6 text-[11px] sm:px-11"
>
  <div class="flex items-center gap-4">
    <ThemeToggle />
  </div>
  <div class="flex items-center gap-5">
    <a href={footer.githubUrl} class="subtle" rel="me noopener noreferrer" target="_blank">
      {footer.githubLabel}<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a href={footer.linkedinUrl} class="subtle" rel="me noopener noreferrer" target="_blank">
      {footer.linkedinLabel}<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</footer>
